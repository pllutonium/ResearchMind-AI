# ==============================================================================
# ResearchMind AI — Environment Configuration Template
# Duplicate this file as '.env' and insert your API credentials.
# ==============================================================================

# --- Google Gemini Cloud (Primary Engine: 100% Free, Sub-second, Zero Laptop Load) ---
# Obtain your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-flash-lite-latest
DEFAULT_LLM_BACKEND=gemini

# --- Optional Groq Cloud Engine (Open-Weight Models) ---
# Obtain your free API key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# --- Optional Offline Local Ollama Engine ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama3.1
LLM_NUM_CTX=2048

LANGFUSE_PUBLIC_KEY=pk-lf-a4f8ded6-1816-4d7e-84f8-a6fdefb35aa9
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Embeddings Model ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
